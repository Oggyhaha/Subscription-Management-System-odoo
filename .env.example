# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/subscription_db?schema=public"

# Auth configuration
AUTH_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars-long"

# Cron secret for automated billing triggering
CRON_SECRET="change-this-to-a-secure-cron-secret"

# Nodemailer SMTP configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="apikey"
SMTP_PASS="secret_smtp_password"
SMTP_FROM_EMAIL="billing@brightloop.com"
SMTP_FROM_NAME="Brightloop Software Billing"

# Application URL
APP_URL="http://localhost:3000"
